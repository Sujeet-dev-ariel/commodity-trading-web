# Copy this file to `.env` and set the backend base URL (with /api/v1 prefix)
# to go live. Local backend default: http://localhost:3000/api/v1
# With no `.env` file (or an empty value), the console runs with no backend:
# lists start empty and the demo OTP login shows the code on-screen.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Live-auth contract (D:\Tradding_backend\routes\auth.js):
#   POST {VITE_API_BASE_URL}/auth/login      { phone: "+91XXXXXXXXXX" }
#   POST {VITE_API_BASE_URL}/auth/verify-otp { phone, otp }   (dev backend: 1111)
# Admin-only is enforced server-side (requireRole(['admin'])); the UI mirrors
# it with a role gate — non-admin sessions see a Forbidden screen.
